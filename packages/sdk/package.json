{
  "name": "@khulnasoft.com/sdk",
  "version": "0.0.1",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "browser": "./dist/index.umd.min.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "tsc": "tsc --module commonjs",
    "build": "npm run tsc && rollup -c",
    "watch": "rollup -cw",
